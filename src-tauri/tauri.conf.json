{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eifel Mastering Central",
  "version": "0.1.0",
  "identifier": "com.mystudio.central",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "npm run build:ui",
    "beforeDevCommand": "npm run build:ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Eifel Mastering Central",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 760,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#1b1b1c"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' data: https://reckyreck.github.io",
        "connect-src": "ipc: http://ipc.localhost https://reckyreck.github.io"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "Music",
    "shortDescription": "Installs and updates all Recky's plug-ins",
    "publisher": "Eifel Mastering",
    "copyright": "Eifel Mastering",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
